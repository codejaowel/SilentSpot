<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.SilentSpot" parent="Theme.Material3.Light.NoActionBar">

        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorTextOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryLight</item>
        <item name="colorOnPrimaryContainer">@color/colorPrimaryDark</item>

        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/colorTextOnAccent</item>
        <item name="colorSecondaryContainer">@color/colorAccentLight</item>

        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorSurfaceVariant">@color/colorOverlay</item>
        <item name="colorOnSurfaceVariant">@color/colorTextSecondary</item>
        <item name="android:colorBackground">@color/colorCanvas</item>
        <item name="colorOnBackground">@color/colorTextPrimary</item>

        <item name="colorOutline">@color/colorBorder</item>
        <item name="colorOutlineVariant">@color/colorDivider</item>

        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>

        <item name="android:windowBackground">@color/colorCanvas</item>
    </style>

    <style name="Theme.SilentSpot" parent="Base.Theme.SilentSpot" />

    <style name="Theme.SilentSpot.Splash" parent="Base.Theme.SilentSpot">
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/colorSplashStart</item>
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>

    <style name="Widget.SilentSpot.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/colorSurface</item>
        <item name="titleTextAppearance">@style/TextAppearance.SilentSpot.ToolbarTitle</item>
    </style>

    <style name="TextAppearance.SilentSpot.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.SilentSpot.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.SilentSpot.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.SilentSpot.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.SilentSpot.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.SilentSpot.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.SilentSpot.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.SilentSpot.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/colorTextMuted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.SilentSpot.DbDisplay" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">48sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <style name="Widget.SilentSpot.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/colorTextOnPrimary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.SilentSpot.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="Widget.SilentSpot.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/colorBorder</item>
        <item name="hintTextColor">@color/colorPrimary</item>
        <item name="boxBackgroundColor">@color/colorSurface</item>
    </style>

    <style name="Widget.SilentSpot.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="strokeColor">@color/colorBorder</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.SilentSpot.Card.Recommendation" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/colorPrimary</item>
    </style>

</resources>
